# ============================================================================
# Copie ce fichier en ".env" (sans ".example") et remplis les valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé ou mis sur GitHub (il contient
# des secrets). Il est déjà exclu par le .gitignore.
# ============================================================================


# ----------------------------------------------------------------------------
# SERVEUR
# ----------------------------------------------------------------------------

# Port sur lequel le serveur Express écoute en local.
PORT=3000

# Adresse publique de ton serveur. En local, laisse localhost. Une fois
# déployé (ex. sur Render), remplace par l'URL fournie par l'hébergeur,
# ex: https://pizza-bona-carte.onrender.com
BASE_URL=http://localhost:3000

# Mot de passe simple que seul le personnel en caisse doit connaître, pour
# avoir le droit d'ajouter des tampons ou de remettre un compteur à zéro.
# Choisis n'importe quelle phrase longue et unique. Laisse vide pour tester
# en local sans t'en soucier (mais mets-en un avant un vrai lancement).
ADMIN_KEY=


# ----------------------------------------------------------------------------
# GOOGLE WALLET (gratuit) — voir README.md section "Google Wallet" pour le
# guide pas-à-pas complet.
# ----------------------------------------------------------------------------

# Chemin vers le fichier JSON de ta clé de compte de service Google Cloud.
# Tu le télécharges depuis Google Cloud Console > IAM & Admin > Comptes de
# service > (ton compte) > Clés > Ajouter une clé > JSON.
# Place ce fichier dans wallet-google/service-account.json (déjà ignoré par git).
GOOGLE_APPLICATION_CREDENTIALS=./wallet-google/service-account.json

# Ton "Issuer ID" Google Wallet : un numéro fourni par Google une fois que tu
# as créé et fait approuver ton compte sur https://pay.google.com/business/console
# (Google Wallet Business Console). Gratuit mais nécessite une validation.
GOOGLE_WALLET_ISSUER_ID=

# Identifiant technique unique pour TA classe de carte de fidélité (le
# "modèle" de carte, un peu comme un nom de produit). Choisis n'importe quel
# texte simple sans espaces, tu n'as rien à créer sur Google pour ça, le code
# le crée automatiquement au premier lancement.
GOOGLE_WALLET_CLASS_SUFFIX=pizza_bona_fidelite

# URL publique (https://...) de ton logo, que Google doit pouvoir télécharger
# pour l'afficher sur la carte. Comme ton site Pizza Bona est déjà en ligne,
# tu peux réutiliser son logo directement :
GOOGLE_WALLET_LOGO_URL=https://4754433.atwebpages.com/images/logo.webp


# ----------------------------------------------------------------------------
# APPLE WALLET (payant : compte Apple Developer à 99$/an) — à remplir plus
# tard. Le code fonctionne sans, il renverra juste une erreur claire tant que
# ces variables sont vides. Voir README.md section "Apple Wallet".
# ----------------------------------------------------------------------------

# Ton "Team ID" Apple, visible sur https://developer.apple.com/account
# (menu Membership / Adhésion). Format: 10 caractères, ex. "AB12CD34EF".
APPLE_TEAM_ID=

# L'identifiant du "Pass Type ID" que tu crées sur
# https://developer.apple.com/account/resources/identifiers/list/passTypeId
# Convention: pass.com.tonnomdedomaine.fidelite
APPLE_PASS_TYPE_IDENTIFIER=pass.com.pizzabona.fidelite

# Certificat Apple WWDR (Worldwide Developer Relations) — téléchargeable
# gratuitement, le même pour tout le monde :
# https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
# Il faut le convertir en .pem (voir README) et le placer ici :
APPLE_WWDR_CERT_PATH=./wallet-apple/certs/wwdr.pem

# Certificat "Pass Type ID" : généré sur developer.apple.com puis exporté
# depuis le Trousseau d'accès (Keychain) de ton Mac au format .p12, puis
# converti en .pem (voir README pour les commandes exactes).
APPLE_SIGNER_CERT_PATH=./wallet-apple/certs/signerCert.pem

# Clé privée associée au certificat ci-dessus (aussi extraite du .p12).
APPLE_SIGNER_KEY_PATH=./wallet-apple/certs/signerKey.pem

# Mot de passe que tu as choisi en exportant la clé privée depuis Keychain.
# Laisse vide si tu n'en as pas défini.
APPLE_SIGNER_KEY_PASSPHRASE=
